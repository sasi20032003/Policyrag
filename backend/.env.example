# --- Server ---
ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/policygraph
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/policygraph

# --- LLM Provider (provider-independent service layer) ---
# Options: 'ollama' (100% Local, Private, Free), 'anthropic', 'openai'
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Optional Cloud API Keys (only needed if LLM_PROVIDER=anthropic or openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# --- OCR (optional) ---
ENABLE_OCR=false
TESSERACT_CMD=/usr/bin/tesseract
